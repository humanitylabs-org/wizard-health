{
  "openapi": "3.1.0",
  "info": {
    "title": "Health API",
    "version": "0.10.1",
    "description": "Box-local API of the Health app. It reads health-data connectors (docs/health-data-contract.md) and never holds provider keys."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Sources (connected, freshness, days held), the shown source and the known connector apps",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/summary": {
      "get": {
        "summary": "Daily summary of the latest (or given) day, for the screen, agents and other apps such as a morning report",
        "parameters": [
          {
            "name": "day",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "source id, default: the source Health shows"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Includes the screen's one traffic light (green good, yellow okay, red needs attention): recovery_colour; sleep_band {colour, word, pct_of_need, by}; activity_match {colour, word, side, strain, target, target_low, target_high}, judged against that day's recovery."
      }
    },
    "/api/days": {
      "get": {
        "summary": "Normalized day records (wizard.health-data/1 day shape), newest first",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "source id, default: the source Health shows"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Each day also carries recovery_colour, sleep_band and activity_match (as in /api/summary)."
      }
    },
    "/api/trends": {
      "get": {
        "summary": "Averages, change vs previous period and day series over 7, 30 or 90 days",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "7, 30 or 90"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "source id, default: the source Health shows"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/workouts": {
      "get": {
        "summary": "Workouts, newest first",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "source id, default: the source Health shows"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sleep": {
      "get": {
        "summary": "Main sleeps, newest first",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM-DD inclusive"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "source id, default: the source Health shows"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/refresh": {
      "post": {
        "summary": "Read every source again now (from the connectors, not the providers)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/primary": {
      "post": {
        "summary": "Choose which source the screen and tools show ({\"id\": ...})",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/forget": {
      "post": {
        "summary": "Remove a source that is no longer installed, with Health's copy of it ({\"id\": ...})",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
